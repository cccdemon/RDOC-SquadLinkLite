{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDOC SquadLink Lite",
  "version": "0.1.32",
  "identifier": "org.raumdock.squadlink-lite",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RDOC SquadLink Lite",
        "width": 960,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://squadlink.raumdock.org wss://squadlink.raumdock.org https://api.github.com https://raw.githubusercontent.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["squadlink"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Raumdock",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libasound2"]
      }
    }
  }
}
