# Test-runner image: every toolchain and system dependency the full test
# suite needs, and NO source. Bind-mount the repo and keep the cargo target in
# a named volume, so an edit-test loop is incremental (see e2e/test-all.sh).
#
#   docker build -t subraum-test -f e2e/Dockerfile.test e2e
#
# The same image is what .gitlab-ci.yml and the GitHub `test` workflow run in,
# so "it passed locally" and "it passed in CI" mean the same thing.
FROM rust:1-bookworm

# Rust workspace: opus (audiopus_sys autogen needs clang), ALSA, aws-lc (cmake).
# src-tauri additionally needs the Tauri Linux stack (webkit2gtk, GTK, rsvg, xdo).
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config clang cmake file \
    libopus-dev libasound2-dev libssl-dev \
    libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev libxdo-dev \
    ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

# Node 22 (what the GitHub/GitLab jobs run; `node --test` needs >= 21 for the
# glob the Stream Deck test script uses) + pnpm 10 for the frontend.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10

RUN rustup component add clippy

ENV CARGO_TARGET_DIR=/target
WORKDIR /work
